# Copy to .env for local use. Never commit the filled-in file.
# The app refuses all pages except /health until APP_PASSWORD is set.

APP_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string
# Set false for local http. Railway sets this true automatically.
COOKIE_SECURE=false

# Railway Postgres injects this. Leave unset locally to use SQLite (./data/local.db).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# yfinance is the default and needs no key. Other values: alpaca, massive,
# databento, ccxt, thetadata, fixture
DATA_PROVIDER=yfinance

# Paper trading. Leave blank to use the built-in paper simulator.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Live mode stays off unless BOTH the flag and the live keys are set.
# This build still never posts an order to the live trading endpoint.
LIVE_TRADING_ENABLED=false
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=

# Optional live-switch confirmation. If set, going live also requires a TOTP code.
TOTP_SECRET=

# Optional data adapters. Unused while DATA_PROVIDER=yfinance.
MASSIVE_API_KEY=
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
THETADATA_USER=
THETADATA_PASS=
THETADATA_BASE_URL=http://127.0.0.1:25510
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# Risk
MAX_DAILY_LOSS_USD=500
MAX_TOTAL_EXPOSURE_USD=100000
MAX_ORDERS_PER_MINUTE=10
PAPER_DAYS_REQUIRED=5
COST_BPS=5

# Optional JSON webhook for kill-switch, loss-limit, and error alerts.
ALERT_WEBHOOK=
